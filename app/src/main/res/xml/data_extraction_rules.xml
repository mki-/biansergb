<?xml version="1.0" encoding="utf-8"?>
<!-- No backup targets: the only persisted state is a MAC address. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
