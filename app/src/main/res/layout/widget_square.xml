<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 — title row + 3x2 colour grid. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/widget_title"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_power"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_circle_off"
            android:gravity="center"
            android:text="@string/widget_on"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_color_0"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_dot_white"
            android:contentDescription="@string/widget_color_white" />

        <ImageButton
            android:id="@+id/widget_color_1"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_dot_pink"
            android:contentDescription="@string/widget_color_pink" />

        <ImageButton
            android:id="@+id/widget_color_2"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_dot_red"
            android:contentDescription="@string/widget_color_red" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_color_3"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_dot_purple"
            android:contentDescription="@string/widget_color_purple" />

        <ImageButton
            android:id="@+id/widget_color_4"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_dot_blue"
            android:contentDescription="@string/widget_color_blue" />

        <ImageButton
            android:id="@+id/widget_color_5"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_dot_cyan"
            android:contentDescription="@string/widget_color_cyan" />
    </LinearLayout>
</LinearLayout>
