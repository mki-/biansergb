<?xml version="1.0" encoding="utf-8"?>
<!--
  2x4 portrait card — CarPlay-style dashboard tile.

  Swatches are ImageViews with a vector `src` + scaleType=fitCenter inside weighted
  cells, so they grow with whatever space the launcher grants. That is what makes the
  card work on a 5" 800x480 head unit (mdpi -> 800x480 dp canvas, lots of room) and on
  a phone (xhdpi -> small dp canvas) without two layouts.

  No swatch has a fixed dp size on purpose; only the chrome (power button, strip, type)
  is density-tuned in res/values*/dimens.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="@dimen/widget_card_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/widget_title"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/widget_title_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_power"
            android:layout_width="@dimen/widget_power_size"
            android:layout_height="@dimen/widget_power_size"
            android:background="@drawable/widget_circle_off"
            android:gravity="center"
            android:text="@string/widget_on"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/widget_power_text"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_color_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_color_white"
            android:padding="@dimen/widget_cell_margin"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_dot_white" />

        <ImageView
            android:id="@+id/widget_color_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_color_pink"
            android:padding="@dimen/widget_cell_margin"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_dot_pink" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_color_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_color_red"
            android:padding="@dimen/widget_cell_margin"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_dot_red" />

        <ImageView
            android:id="@+id/widget_color_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_color_purple"
            android:padding="@dimen/widget_cell_margin"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_dot_purple" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_color_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_color_blue"
            android:padding="@dimen/widget_cell_margin"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_dot_blue" />

        <ImageView
            android:id="@+id/widget_color_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_color_cyan"
            android:padding="@dimen/widget_cell_margin"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_dot_cyan" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_strip_height"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_hue_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_hue_0"
            android:contentDescription="@string/widget_hue_red" />

        <ImageButton
            android:id="@+id/widget_hue_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_hue_2"
            android:contentDescription="@string/widget_hue_yellow" />

        <ImageButton
            android:id="@+id/widget_hue_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_hue_4"
            android:contentDescription="@string/widget_hue_green" />

        <ImageButton
            android:id="@+id/widget_hue_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_hue_6"
            android:contentDescription="@string/widget_hue_cyan" />

        <ImageButton
            android:id="@+id/widget_hue_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_hue_8"
            android:contentDescription="@string/widget_hue_blue" />

        <ImageButton
            android:id="@+id/widget_hue_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_hue_10"
            android:contentDescription="@string/widget_hue_magenta" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:text="@string/widget_state_connect"
        android:textColor="#8E8E93"
        android:textSize="@dimen/widget_state_text" />
</LinearLayout>
