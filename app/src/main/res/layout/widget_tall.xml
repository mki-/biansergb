<?xml version="1.0" encoding="utf-8"?>
<!--
  2x4 portrait card, CarPlay-inspired: one big round power button, an evenly spaced
  3x2 swatch grid, and a segmented hue strip (the closest a home-screen widget can get
  to a colour slider — RemoteViews has no SeekBar).

  Background tap opens the app; every control fires a broadcast and drives the lamp
  without leaving the launcher.

  Sizing note: at minWidth 110dp the usable width is 90dp (10dp padding each side), so
  two 36dp swatches + a 16dp gap = 88dp fits exactly. Do not enlarge the swatches
  without also lowering the horizontal padding.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <!-- header: title + round power button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/widget_title"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_power"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_circle_off"
            android:gravity="center"
            android:text="@string/widget_on"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3 rows x 2 cols, equal weight so the vertical rhythm stays even -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_color_0"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_dot_white"
            android:contentDescription="@string/widget_color_white" />

        <ImageButton
            android:id="@+id/widget_color_1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/widget_dot_pink"
            android:contentDescription="@string/widget_color_pink" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_color_2"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_dot_red"
            android:contentDescription="@string/widget_color_red" />

        <ImageButton
            android:id="@+id/widget_color_3"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/widget_dot_purple"
            android:contentDescription="@string/widget_color_purple" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_color_4"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_dot_blue"
            android:contentDescription="@string/widget_color_blue" />

        <ImageButton
            android:id="@+id/widget_color_5"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/widget_dot_cyan"
            android:contentDescription="@string/widget_color_cyan" />
    </LinearLayout>

    <!-- segmented hue strip: 6 steps of 60 degrees, reads as a colour slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_hue_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_hue_0"
            android:contentDescription="@string/widget_hue_red" />

        <ImageButton
            android:id="@+id/widget_hue_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_hue_2"
            android:contentDescription="@string/widget_hue_yellow" />

        <ImageButton
            android:id="@+id/widget_hue_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_hue_4"
            android:contentDescription="@string/widget_hue_green" />

        <ImageButton
            android:id="@+id/widget_hue_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_hue_6"
            android:contentDescription="@string/widget_hue_cyan" />

        <ImageButton
            android:id="@+id/widget_hue_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_hue_8"
            android:contentDescription="@string/widget_hue_blue" />

        <ImageButton
            android:id="@+id/widget_hue_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_hue_10"
            android:contentDescription="@string/widget_hue_magenta" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:text="@string/widget_state_connect"
        android:textColor="#8E8E93"
        android:textSize="11sp" />
</LinearLayout>
