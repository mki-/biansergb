<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 — the full card: title + power + six large swatches + open button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/widget_title"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_power"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/widget_circle_off"
            android:gravity="center"
            android:text="@string/widget_on"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_color_0"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_dot_white"
            android:contentDescription="@string/widget_color_white" />

        <ImageButton
            android:id="@+id/widget_color_1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_dot_pink"
            android:contentDescription="@string/widget_color_pink" />

        <ImageButton
            android:id="@+id/widget_color_2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_dot_red"
            android:contentDescription="@string/widget_color_red" />

        <ImageButton
            android:id="@+id/widget_color_3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_dot_purple"
            android:contentDescription="@string/widget_color_purple" />

        <ImageButton
            android:id="@+id/widget_color_4"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_dot_blue"
            android:contentDescription="@string/widget_color_blue" />

        <ImageButton
            android:id="@+id/widget_color_5"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_dot_cyan"
            android:contentDescription="@string/widget_color_cyan" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/widget_state_connect"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_open"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/widget_pill_accent"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/widget_open"
            android:textColor="#7C3AED"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
