<?xml version="1.0" encoding="utf-8"?>
<!--
  4x2 — header + six swatches + state/open row.
  No hue strip here: at minHeight 110dp a fourth row does not fit, so the strip stays
  exclusive to the 2x4 card.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="@dimen/widget_card_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/widget_title"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/widget_title_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_power"
            android:layout_width="@dimen/widget_power_size"
            android:layout_height="@dimen/widget_power_size"
            android:background="@drawable/widget_circle_off"
            android:gravity="center"
            android:text="@string/widget_on"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/widget_power_text"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_color_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_color_white"
            android:padding="@dimen/widget_cell_margin"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_dot_white" />

        <ImageView
            android:id="@+id/widget_color_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_color_pink"
            android:padding="@dimen/widget_cell_margin"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_dot_pink" />

        <ImageView
            android:id="@+id/widget_color_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_color_red"
            android:padding="@dimen/widget_cell_margin"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_dot_red" />

        <ImageView
            android:id="@+id/widget_color_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_color_purple"
            android:padding="@dimen/widget_cell_margin"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_dot_purple" />

        <ImageView
            android:id="@+id/widget_color_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_color_blue"
            android:padding="@dimen/widget_cell_margin"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_dot_blue" />

        <ImageView
            android:id="@+id/widget_color_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_color_cyan"
            android:padding="@dimen/widget_cell_margin"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_dot_cyan" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/widget_state_connect"
            android:textColor="#8E8E93"
            android:textSize="@dimen/widget_state_text" />

        <TextView
            android:id="@+id/widget_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_accent"
            android:gravity="center"
            android:minHeight="28dp"
            android:minWidth="64dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/widget_open"
            android:textColor="#0B0B0F"
            android:textSize="@dimen/widget_state_text"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
