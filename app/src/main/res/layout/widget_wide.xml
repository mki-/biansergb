<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1 — one row: power toggle + six colour swatches. Tap card = open app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/widget_power"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_circle_off"
        android:gravity="center"
        android:text="@string/widget_on"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/widget_color_0"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/widget_dot_white"
        android:contentDescription="@string/widget_color_white" />

    <ImageButton
        android:id="@+id/widget_color_1"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_dot_pink"
        android:contentDescription="@string/widget_color_pink" />

    <ImageButton
        android:id="@+id/widget_color_2"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_dot_red"
        android:contentDescription="@string/widget_color_red" />

    <ImageButton
        android:id="@+id/widget_color_3"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_dot_purple"
        android:contentDescription="@string/widget_color_purple" />

    <ImageButton
        android:id="@+id/widget_color_4"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_dot_blue"
        android:contentDescription="@string/widget_color_blue" />

    <ImageButton
        android:id="@+id/widget_color_5"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_dot_cyan"
        android:contentDescription="@string/widget_color_cyan" />
</LinearLayout>
