<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Platform theme only (no AppCompat / Material Views dependency — the UI is
      100% Compose). The window background matches the top of the app's gradient so
      there is no flash of a different colour during launch.
    -->
    <style name="Theme.AmbientLamp" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF1E1B4B</item>
        <item name="android:colorBackground">#FF1E1B4B</item>
        <item name="android:statusBarColor">#FF1E1B4B</item>
        <item name="android:navigationBarColor">#FF020617</item>
    </style>
</resources>
